# Copier en .env.local et compléter. Ne jamais committer .env.local.

# Supabase — publiques (exposées au navigateur, protégées par la RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SECRÈTE, serveur uniquement (invitations par email)
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (liens d'invitation, redirections auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fond de carte PMTiles (phase 3)
NEXT_PUBLIC_TILES_BASE_URL=
