# Copier en .env.local et compléter. Ne jamais committer .env.local.

# Supabase — publiques (exposées au navigateur, protégées par la RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase — SECRÈTE, serveur uniquement (invitations par email). Jamais préfixée NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Clés publiques de signature des JWT (vérification locale des sessions côté serveur)
SUPABASE_JWKS_URL=https://xxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# URL publique de l'application (liens d'invitation, redirections auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fond de carte PMTiles (phase 3)
NEXT_PUBLIC_TILES_BASE_URL=
