{
  "name": "japan-trip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "bash scripts/test-db.sh",
    "typecheck": "tsc --noEmit",
    "test:db:remote": "bash scripts/test-db-remote.sh",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 vitest run --config vitest.integration.config.mts",
    "test:e2e": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 sh -c 'node tests/e2e/collaboration.e2e.mjs && node tests/e2e/planning.e2e.mjs && node tests/e2e/map.e2e.mjs && node tests/e2e/tickets.e2e.mjs && node tests/e2e/stays.e2e.mjs && node tests/e2e/journal.e2e.mjs && node tests/e2e/dashboard.e2e.mjs'",
    "db:push:remote": "bash scripts/db-push-remote.sh",
    "travelers": "node scripts/travelers.mjs",
    "predev": "node scripts/copy-vendor-assets.mjs",
    "prebuild": "node scripts/copy-vendor-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "bwip-js": "^4.11.4",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "maplibre-gl": "^6.17.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
